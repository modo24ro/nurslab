# NursLab Environment Configuration
APP_NAME=NursLab - Nursing Practice
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=dev-secret-key-change-in-production-must-be-at-least-32-chars-long!
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nurslab_db
POSTGRES_USER=nurslab_user
POSTGRES_PASSWORD=nurslab_secure_password
DATABASE_URL=postgresql+asyncpg://nurslab_user:nurslab_secure_password@postgres:5432/nurslab_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Storage
MEDIA_UPLOAD_DIR=/app/media_uploads
MAX_UPLOAD_SIZE_MB=50

# Invoicing & RO e-Factura config
INVOICE_SERIES=NLB
INVOICE_START_NUMBER=1001
COMPANY_NAME=NursLab Medical Education S.R.L.
COMPANY_CUI=RO12345678
COMPANY_REG_COM=J40/1234/2026
COMPANY_ADDRESS=Str. Sanatatii Nr. 10, Sector 1, Bucuresti

# Stripe / Payments Sandbox
STRIPE_PUBLIC_KEY=pk_test_sample
STRIPE_SECRET_KEY=sk_test_sample
STRIPE_WEBHOOK_SECRET=whsec_sample
